# Number of facilities per city (address must resolve to a schema:PostalAddress).
# Values are trimmed; empty values are left out.
# Params: none
# Used by: SparqlClient.generate_statistics (facilities_by_city)
PREFIX schema: <http://schema.org/>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX cdf: <https://civic-data.de/federated-directory#>

SELECT ?value (COUNT(DISTINCT ?facility) AS ?count) WHERE {
    ?facility a org:OrganizationalUnit ;
              schema:address ?address .
    ?address a schema:PostalAddress ;
             schema:addressLocality ?raw .
    BIND(REPLACE(STR(?raw), "^\\s+|\\s+$", "") AS ?value)
    FILTER(?value != "")
}
GROUP BY ?value
ORDER BY DESC(?count) ?value
