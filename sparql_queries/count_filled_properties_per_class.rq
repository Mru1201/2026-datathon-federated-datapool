# For each dataset class and property: how many entities have a non-blank value.
# Blank = only whitespace. IRI values always count as filled (like a filled CSV cell).
# Params: none
# Used by: SparqlClient.check_completeness -> MCP tool check_completeness
PREFIX schema: <http://schema.org/>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX cdf: <https://civic-data.de/federated-directory#>

SELECT ?class ?property (COUNT(DISTINCT ?entity) AS ?filled) WHERE {
    VALUES ?class { org:OrganizationalUnit schema:PostalAddress schema:Service schema:Organization }
    ?entity a ?class ;
            ?property ?value .
    FILTER(!isLiteral(?value) || REGEX(STR(?value), "\\S"))
}
GROUP BY ?class ?property
