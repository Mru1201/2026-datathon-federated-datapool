# Count facilities whose address is in the given city (case-insensitive exact match).
# Params: {{city}}
# Used by: SparqlClient.count_facilities -> MCP tool count_facilities_with_api
PREFIX schema: <http://schema.org/>
PREFIX org: <http://www.w3.org/ns/org#>

SELECT (COUNT(DISTINCT ?facility) AS ?count) WHERE {
    ?facility a org:OrganizationalUnit ;
              schema:address ?address .
    ?address schema:addressLocality ?city .
    FILTER(LCASE(STR(?city)) = LCASE("{{city}}"))
}
