# List facilities in a given German postal code area.
# Params: {{postal_code}}
# Used by: SparqlClient.search_by_postal_code -> MCP tool search_by_postal_code
PREFIX schema: <http://schema.org/>
PREFIX org:    <http://www.w3.org/ns/org#>
PREFIX foaf:   <http://xmlns.com/foaf/0.1/>

SELECT ?facility
       (SAMPLE(?name_) AS ?name)
       (SAMPLE(?street_) AS ?street)
       (SAMPLE(?postal_code_) AS ?postal_code)
       (SAMPLE(?city_) AS ?city)
       (GROUP_CONCAT(DISTINCT STR(?telephone_); separator="; ") AS ?telephone)
       (GROUP_CONCAT(DISTINCT STR(?email_); separator="; ") AS ?email)
       (GROUP_CONCAT(DISTINCT STR(?homepage_); separator="; ") AS ?homepage)
WHERE {
  ?facility a org:OrganizationalUnit ;
            schema:address ?addr .
  ?addr a schema:PostalAddress ;
        schema:postalCode ?postal_code_ .
  FILTER(STR(?postal_code_) = "{{postal_code}}")
  OPTIONAL { ?facility schema:name ?name_ }
  OPTIONAL { ?addr schema:streetAddress ?street_ }
  OPTIONAL { ?addr schema:addressLocality ?city_ }
  OPTIONAL { ?facility schema:telephone ?telephone_ }
  OPTIONAL { ?facility schema:email ?email_ }
  OPTIONAL { ?facility foaf:homepage ?homepage_ }
}
GROUP BY ?facility
ORDER BY ?facility
