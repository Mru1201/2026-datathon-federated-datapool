# Number of facilities per provider name (parentOrganization must resolve to a schema:Organization).
# Values are trimmed; empty values are left out.
# Params: none
# Used by: SparqlClient.generate_statistics (facilities_by_provider)
PREFIX schema: <http://schema.org/>
PREFIX org: <http://www.w3.org/ns/org#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX cdf: <https://civic-data.de/federated-directory#>

SELECT ?value (COUNT(DISTINCT ?facility) AS ?count) WHERE {
    ?facility a org:OrganizationalUnit ;
              schema:parentOrganization ?provider .
    ?provider a schema:Organization ;
              schema:name ?raw .
    BIND(REPLACE(STR(?raw), "^\\s+|\\s+$", "") AS ?value)
    FILTER(?value != "")
}
GROUP BY ?value
ORDER BY DESC(?count) ?value
