# Federated Welfare Directory MCP — environment variables
# Copy to .env and adjust as needed.

# SPARQL endpoint for the federated data pool.
# Default points to the public CorrelAid instance.
SPARQL_ENDPOINT=https://sosuse.correlaid.org/directory/sparql

# HTTP request timeout in seconds (the public endpoint enforces 30s server-side).
SPARQL_TIMEOUT=30.0

# Result cache TTL in seconds for expensive aggregate queries (0 = disabled).
CACHE_TTL=300

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
