# Copy to .env and fill in. .env is gitignored.
# OPENWEBUI_* is only needed for the LLM tests (tests/llm, tests/evals).
OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_API_KEY=
# Default model for evals (override with --models; "all" = every model)
OPENWEBUI_MODEL=qwen3:8b
# SPARQL endpoint for the tests (default below). server.py does not read .env: set
# SPARQL_ENDPOINT in the MCP client config ("env" key) to point the server elsewhere.
SPARQL_ENDPOINT=https://sosuse.correlaid.org/directory/sparql
